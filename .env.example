# Giá trị giả, chỉ dùng cho máy phát triển. KHÔNG đặt secret thật ở đây.
DATABASE_URL="postgresql://ccl:ccl@localhost:5432/ccl_dev?schema=public"
REDIS_URL="redis://localhost:6379"
# Mức log: debug | info | warn | error
LOG_LEVEL="info"
# Database riêng cho test tích hợp (tên phải có chữ "test"; test sẽ tạo và xóa dữ liệu trong đó)
DATABASE_URL_TEST="postgresql://ccl:ccl@localhost:5432/ccl_test?schema=public"
# Khóa bí mật của máy chủ (HMAC cho mã OTP), tối thiểu 32 ký tự. Giá trị dưới đây chỉ dùng cho
# máy phát triển. Production đặt giá trị ngẫu nhiên trong trình quản lý secret, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="chi-dung-cho-may-phat-trien-doi-tren-production"
# Cách gửi email: console (in ra màn hình, máy phát triển) | memory (test)
MAIL_TRANSPORT="console"
